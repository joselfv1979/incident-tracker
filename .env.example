# Database
DB_URL=jdbc:postgresql://localhost:5432/incidents
DB_USER=incidents-user
DB_PASSWORD=change-me
DB_NAME=incidents

# Security
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=1h

# Initial administrator, created at startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# Frontend
VITE_API_URL=/api

# Mail (development uses Mailpit from docker-compose)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@incident-tracker.local
APP_BASE_URL=http://localhost:5173
